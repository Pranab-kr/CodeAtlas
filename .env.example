# Clerk authentication & workspaces (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase database & Realtime (required)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret key used by the background analysis pipeline. Never prefix with NEXT_PUBLIC_.
SUPABASE_API_KEY=sb_secret_...

# GitHub API token (recommended in production to raise the 60 req/hr unauthenticated limit to 5,000 req/hr)
GITHUB_TOKEN=

# AI explanations (optional — map works without these)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Managed Deep Agents "Ask" pane (optional — map works without these)
AGENT_URL=
AGENT_ASSISTANT_ID=code-atlas-agent
# Required for deployed LangSmith Agent Server; omit for local `mda dev`
AGENT_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=code-atlas
