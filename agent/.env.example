# LangSmith & Managed Deep Agents (required)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Model provider (required unless using another provider via AGENT_MODEL)
# The `openai:` integration reads OPENAI_API_KEY and OPENAI_BASE_URL, so the
# same OpenAI-compatible provider used by the Next.js app can drive the agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=

# Optional: full provider:model override (defaults to openai:$AI_MODEL)
AGENT_MODEL=

# CodeAtlas read-only tools endpoint (required)
# Local development: http://127.0.0.1:3000/api/agent/tools
# Production: https://<your-app-domain>/api/agent/tools
ATLAS_TOOLS_URL=http://127.0.0.1:3000/api/agent/tools
