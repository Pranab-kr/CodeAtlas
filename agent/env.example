# Managed Deep Agents (local development).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# The `openai:` model string uses these. OPENAI_BASE_URL lets the same
# OpenAI-compatible provider the app uses drive the agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=
# Optional: a complete provider:model override, e.g. openai:gpt-5.5
AGENT_MODEL=

# The CodeAtlas read-only tools surface.
ATLAS_TOOLS_URL=http://127.0.0.1:3000/api/agent/tools
